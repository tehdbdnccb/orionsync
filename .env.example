# Application Config
ENVIRONMENT=development
DEBUG=True

# Twilio (Gateway)
TWILIO_ACCOUNT_SID=AC_your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# OpenAI (Brain)
OPENAI_API_KEY=sk-proj_your_openai_key_here

# Database (State)
# Example Supabase format: postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite+aiosqlite:///:memory: 

# Stripe (Invoicing)
STRIPE_SECRET_KEY=sk_test_1234567890